# Firebase web app configuration (Firebase console > Project settings > Your apps).
# These values are public identifiers, not secrets, but keep your own out of git.
# Without them the shop works; sign in and sign up are disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
